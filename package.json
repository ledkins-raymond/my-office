{
  "name": "my-office",
  "productName": "My Office",
  "version": "0.1.0",
  "description": "Personal Word, Excel and PowerPoint replacements that save standard Office files",
  "author": "Ray Ledkins",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/ledkins-raymond/my-office.git"
  },
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "vite build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.ledkins.myoffice",
    "productName": "My Office",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "My Word"
    }
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0"
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "docx": "^9.15.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5"
  }
}
